epsilon <- 0.001  # small value to move 0/1 inward
df_results <- df_results %>%
mutate(
accuracy_adj = case_when(
fasttext_top_word_accuracy == 0 ~ epsilon,
fasttext_top_word_accuracy == 1 ~ 1 - epsilon,
TRUE ~ fasttext_top_word_accuracy
),
accuracy_logit = log(accuracy_adj / (1 - accuracy_adj))
)
model <- lmer(
accuracy_logit ~ modality + (1|word_index:task),
data = df_results
)
tab_model(model, show.se=TRUE, show.stat=TRUE, show.r2=TRUE, show.df=TRUE)
AIC(model)
# Display results of fixed effects
display_model_summary(model)
# Conduct pairwise comparisons between modalities
pairwise_comparisons <- emmeans(model, pairwise ~ modality)
display_pairwise_comparisons(pairwise_comparisons)
plot_model(model)
plot_model(model, type='pred', terms=c('prominence_mean_words5', 'modality'))
plot_model(model, type='pred', terms=c('modality'))
