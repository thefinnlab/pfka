library(glmmTMB)
model <- glmmTMB(fasttext_top_word_accuracy ~ modality + (1|word_index:task),
family=beta_family(), data=df_results)
continuous_accuracy_formula <- 'fasttext_top_word_accuracy ~ modality + (1|word_index:task)'
# Fit the logistic mixed-effects model
# model <- lmer(continuous_accuracy_formula, data=df_results)
# # Fit the logistic mixed-effects model
# model <- glmer(continuous_accuracy_formula,
#                data = df_results,
#                family = binomial(link = "logit"))
epsilon <- 0.001  # small value to move 0/1 inward
df_results <- df_results %>%
mutate(
accuracy_adj = case_when(
continuous_accuracy == 0 ~ epsilon,
continuous_accuracy == 1 ~ 1 - epsilon,
TRUE ~ continuous_accuracy
),
accuracy_logit = log(accuracy_adj / (1 - accuracy_adj))
)
model <- lmer(
accuracy_logit ~ modality + (1|word_index:task),
data = df_results
)
continuous_accuracy_formula <- 'fasttext_top_word_accuracy ~ modality + (1|word_index:task)'
